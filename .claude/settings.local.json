{
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "mcp__ide__getDiagnostics",
      "Bash(npx tsc:*)",
      "Bash(npm run build:*)",
      "Bash(find:*)",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_take_screenshot",
      "Bash(npm start)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/custom_hook_scripts/run-prettier.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/custom_hook_scripts/check-eslint.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/custom_hook_scripts/inject-eslint-feedback.py"
          }
        ]
      }
    ]
  },
  "outputStyle": "default"
}
