meta {
  name: Upload Files
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/upload-files
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:multipart-form {
  folder: {{folder}}
  files: @file(/absolute/path/to/photo1.webp|/absolute/path/to/photo2.webp)
}

assert {
  res.status: eq 200
}

docs {
  Admin-only endpoint - requires FILE_SERVER_ADMIN_TOKEN (set as adminToken
  in the environment) to match ADMIN_TOKEN on the server. Replace the
  @file(...) paths with real files before sending; add or remove
  pipe-separated paths in the single files: line to change how many you
  upload (server caps it at 10 per request). Multiple files under one
  multipart field name must go in one @file(a|b|c) call, not repeated
  files: lines - Bruno's block parser overwrites duplicate keys.
}
