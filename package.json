{
  "name": "kubacovy-hory-ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prebuild": "node ./scripts/inject-env.js",
    "start": "ng serve",
    "build": "ng build --base-href=/hory/",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "add-activity": "tsx ./scripts/add-activity.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,html,scss,css,json}": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.27",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/forms": "^20.3.27",
    "@angular/platform-browser": "^20.3.27",
    "@angular/platform-browser-dynamic": "^20.3.27",
    "@angular/router": "^20.3.27",
    "@swimlane/ngx-charts": "^23.1.0",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^2.0.0-alpha",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tsx": "^4.20.6",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.1.1",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/build": "^20.3.33",
    "@angular/cli": "^20.3.33",
    "@angular/compiler-cli": "^20.3.27",
    "@tmcw/togeojson": "^7.1.2",
    "@types/jasmine": "~5.1.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@xmldom/xmldom": "^0.9.10",
    "dotenv": "^16.5.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "xml2js": "^0.6.2"
  }
}
